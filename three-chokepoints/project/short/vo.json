"lines": [
{
"start": 0.25,
"end": 4.499,
"text": "Every day, the world's economy squeezes through three narrow gaps in the sea."
},
{
"start": 5.85,
"end": 9.09,
"text": "The Strait of Hormuz. Just thirty-nine kilometres wide."
},
{
"start": 9.25,
"end": 14.804,
"text": "Twenty million barrels of oil pass through it every day. A fifth of all the oil the world uses."
},
{
"start": 17.2,
"end": 22.248,
"text": "Bab el Mandeb. When ships came under attack here, oil flows fell by more than half."
},
{
"start": 22.85,
"end": 26.905,
"text": "Tankers took the long way, around Africa. Fifteen extra days."
},
{
"start": 27.05,
"end": 32.918,
"text": "And the Strait of Malacca. Less than three kilometres wide. It carries even more oil than Hormuz."
},
{
"start": 34.75,
"end": 35.871,
"text": "Block any one of them,"
},
{
"start": 36.6,
"end": 37.997,
"text": "and the whole world feels it."
}
]
}